{
  "name": "zombie-drive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/main.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx scripts/test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint:fix": "eslint --fix .",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "phaser": "3.90.0",
    "planck": "1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
