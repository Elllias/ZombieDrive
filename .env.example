# Production: external PostgreSQL. npm run dev manages a local database automatically.
DATABASE_URL=postgresql://zombie:local-development@127.0.0.1:55432/postgres
PORT=3001
HOST=127.0.0.1
# Set to your public HTTPS origin when deploying inside Telegram.
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# Server only. Use the token of the bot that launches this Mini App.
TELEGRAM_BOT_TOKEN=
